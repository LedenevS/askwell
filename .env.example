# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# OpenRouter (https://openrouter.ai/keys) — any OpenAI-compatible endpoint works
OPENROUTER_API_KEY=sk-or-...
AI_BASE_URL=https://openrouter.ai/api/v1
AI_EMBEDDING_MODEL=openai/text-embedding-3-small   # must produce 1536-dim vectors
AI_CHAT_MODEL=openai/gpt-4o-mini                    # Free + Starter plans
AI_CHAT_MODEL_PREMIUM=openai/gpt-4o                 # Pro plan

# Public URL of this deployment (used for the widget snippet + metadata)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public key of the assistant shown in the landing-page live demo (optional)
NEXT_PUBLIC_DEMO_BOT_KEY=
